# Python
__pycache__/
*.pyc
*.egg-info/
dist/

# Secrets: compose credentials live only on each machine (.env.example is tracked)
.env

# Environments and tool caches
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Local raster artifacts and downloads (COGs, LAZ) live outside git, and so do
# the run logs under data/runs/
data/

# What a deployed machine is currently serving: the city configs `publish` put
# there. Tracked configs live in cities/; this is runtime state, and the whole
# point of ADR-025 is that git does not get a second opinion about it.
live/

# Scratch del MCP de Playwright (capturas y logs de sesiones de agente)
.playwright-mcp/

# Capturas sueltas en la raiz. Ya se colaron 6,3 MB en un commit por un
# `git add -A`, y este repo es publico: una vez empujado, el blob se queda en
# la historia para siempre. Las capturas que documenten algo van al vault.
/*.png
/*.jpg
/*.jpeg
/*.webp
